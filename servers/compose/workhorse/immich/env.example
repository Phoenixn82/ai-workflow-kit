# Copy to .env next to compose.yaml, chmod 600 .env, fill in. Immich reads it too (env_file).
# Your timezone (list: timedatectl list-timezones)
TZ=Etc/UTC
# Originals of phone uploads. Inside the folder media-backup copies, e.g. a hidden folder in your media disk.
UPLOAD_LOCATION=/srv/media/.immich
# Thumbnails and re-encoded video: fast local disk. Rebuilt by Immich if lost.
CACHE_LOCATION=/var/lib/immich
# Postgres data: local SSD only (not a network share, not a USB stick)
DB_DATA_LOCATION=/var/lib/immich/postgres
# Your existing photo and video folder, mounted read-only. Add it in Immich as an External Library at /external/library
EXTERNAL_LIBRARY=/srv/media/Photos
# Database login (only Immich and its database container use it). Letters and digits only:
#   openssl rand -hex 24
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
