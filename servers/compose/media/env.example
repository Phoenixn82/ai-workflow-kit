# Copy to .env (chmod 600 .env) and fill in. Never commit .env.

# Your user's ids (run: id -u ; id -g). Files in DATA_DIR are owned by this user.
PUID=1000
PGID=1000
# Change to your timezone, e.g. Europe/Berlin (list: timedatectl list-timezones)
TZ=Etc/UTC

# Where media lives. Layout: DATA_DIR/downloads (torrent client) and DATA_DIR/media/{movies,tv} (library).
# Same filesystem for both, so hardlinks work.
DATA_DIR=/srv/media

# Address the web UIs listen on. Keep 127.0.0.1 and use `tailscale serve` (see media.md).
BIND_IP=127.0.0.1
# Jellyfin only: set to 0.0.0.0 if TVs on your home Wi-Fi (not on the tailnet) must reach it.
JELLYFIN_BIND=127.0.0.1

# Linux with an Intel/AMD iGPU: hardware transcoding. Uncomment, and set RENDER_GID
# (the group id that owns the GPU device: stat -c %g /dev/dri/renderD128).
#COMPOSE_FILE=compose.yaml:compose.hwaccel.yaml
#RENDER_GID=992

# ---- "arr" profile only ----
# VPN: any provider gluetun supports, WireGuard. See https://github.com/qdm12/gluetun-wiki
# Provider name as gluetun spells it. Ones with port forwarding (lets peers reach you, much faster) include
# protonvpn, airvpn, privateinternetaccess, perfect privacy.
VPN_SERVICE_PROVIDER=
WIREGUARD_PRIVATE_KEY=
# Some providers also need the tunnel address, e.g. WIREGUARD_ADDRESSES=<the Address line of your provider's WireGuard file>
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
# on = ask the provider for a forwarded port (port-sync.sh copies it into Transmission every 2 min).
# If the tunnel connects but nothing passes traffic, try off: some servers/plans refuse forwarding.
VPN_PORT_FORWARDING=on
# Alternative: VPN_SERVICE_PROVIDER=custom and put the provider's WireGuard file at ./gluetun/wireguard/wg0.conf

# Transmission web UI login (pick your own)
TRANSMISSION_USER=admin
TRANSMISSION_PASS=change-me-to-a-long-random-string
