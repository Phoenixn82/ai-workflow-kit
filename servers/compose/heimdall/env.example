# Copy to .env (chmod 600 .env).
# Change to your timezone, e.g. Europe/Berlin (list: timedatectl list-timezones)
TZ=Etc/UTC
# The URL your phone uses to reach ntfy (the MagicDNS name of this box). ntfy and uptime-kuma listen on 127.0.0.1
# only; share them with your tailnet: sudo tailscale serve --bg --http=8090 http://127.0.0.1:8090  (and 3001)
NTFY_BASE_URL=http://heimdall:8090
# Pi-hole profile only: the admin page password. Empty: Pi-hole makes a random one (docker logs pihole | grep password).
PIHOLE_PASSWORD=
# Default upstream is local Unbound (127.0.0.1#5335). Without Unbound, for example:
#PIHOLE_UPSTREAMS=9.9.9.9;149.112.112.112

# ---- Monitoring and security (optional profiles; profiles/heimdall/README.md) ----
# Beszel: the address agents and links use, i.e. what `tailscale serve --https=8490` prints.
#BESZEL_APP_URL=https://heimdall.your-tailnet.ts.net:8490
# Homepage answers only for the host names listed here (comma separated): add the tailscale serve one.
#HOMEPAGE_ALLOWED_HOSTS=heimdall.your-tailnet.ts.net:3010,127.0.0.1:3010
# Wazuh MCP: its settings go in wazuh-mcp.env next to this file (chmod 600), not here:
#   WAZUH_HOST=127.0.0.1               the Wazuh API, published on 127.0.0.1:55000
#   WAZUH_USER=mcp-api                 a Wazuh API user with the built-in "readonly" role
#   WAZUH_PASS=...
#   WAZUH_INDEXER_HOST=127.0.0.1       the indexer, published on 127.0.0.1:9200
#   WAZUH_INDEXER_USER=mcp-readonly    an indexer user with the "readall" role
#   WAZUH_INDEXER_PASS=...
#   VERIFY_SSL=false                   Wazuh's certificates name wazuh.manager, not 127.0.0.1; traffic stays on this box
#   MCP_API_KEY=...                    a long random string (openssl rand -hex 32); clients trade it for a token
