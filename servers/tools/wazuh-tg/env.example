# /etc/wazuh-tg/env (root, chmod 600). Every line is optional; these are the defaults.
#WAZUH_ALERTS=/var/lib/docker/volumes/single-node_wazuh_logs/_data/alerts/alerts.json
#MIN_LEVEL=12
#QUIET_SECONDS=3600
# Send as this user through /usr/local/bin/heimdall-alert (telegram add-on: topic fleet). Empty: /usr/local/bin/alert.
#NOTIFY_USER=you
