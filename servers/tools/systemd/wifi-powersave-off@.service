# Wi-Fi power saving makes a laptop server slow (high LAN ping times) and drops .local lookups.
# Enable per interface: systemctl enable --now wifi-powersave-off@wlan0.service  (name from: iw dev)
[Unit]
Description=Disable Wi-Fi power saving on %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/iw dev %i set power_save off

[Install]
WantedBy=multi-user.target
