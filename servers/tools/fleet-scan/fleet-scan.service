# /etc/systemd/system/fleet-scan.service on heimdall. Report only; a failed run alerts through alert@.
[Unit]
Description=Weekly fleet malware check (report only)
Wants=network-online.target
After=network-online.target tailscaled.service
OnFailure=alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fleet-scan
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=3h
