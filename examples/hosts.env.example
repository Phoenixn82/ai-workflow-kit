# ~/.config/ai-workflow-kit/hosts.env: where your machines are. Copy this file there, chmod 600, fill in what you have.
# Tools read KEY=value lines (the last one wins; an environment variable of the same name wins over the file).
# KIT_HOSTS_ENV=<path> points the tools at another file. Leave a key empty if you don't have that machine:
# a tool that needs it stops with "set KEY in hosts.env", nothing guesses.
# Values are tailnet names (MagicDNS, e.g. thor) or IP addresses. Never put tokens or passwords here.

# thor: the GPU box (Ollama, Whisper, backups). thor-up probes THOR_HOST on port 22 and wakes it with THOR_MAC.
THOR_HOST=
THOR_MAC=
# Ollama on thor for the big models, e.g. http://thor:11434
THOR_OLLAMA_URL=
# Optional: the LAN address thor's boot image answers ssh on while it waits for a disk passphrase (fleet-wake).
THOR_UNLOCK_HOST=

# odin: the cockpit laptop. Only needed if heimdall's fleet-wake should wake it too.
ODIN_HOST=
ODIN_MAC=
# The LAN address odin's boot image answers ssh on while it waits for the disk password (see servers/tools/luks-unlock).
ODIN_UNLOCK_HOST=

# heimdall: the always-on box. The vault-search embed container binds to this address (Compose refuses to start without it).
HEIMDALL_HOST=
# Your LAN broadcast address for Wake-on-LAN, e.g. 192.0.2.255 (255.255.255.255 is always tried too).
LAN_BROADCAST=

# Embedding server for vault-recall (Ollama with nomic-embed-text), e.g. heimdall. Needed to build the index;
# with an index built, queries answer keyword-only while it is empty or down.
EMBED_URL=
# Optional free-model router (FreeLLMAPI): its OpenAI-compatible /v1 base URL, e.g. http://thor:3001/v1
FREELLMAPI_URL=
# Optional read-only Wazuh MCP server on heimdall (its tailscale serve address), for odin's wazuh-mcp-headers helper,
# e.g. https://heimdall.your-tailnet.ts.net:8770 (profiles/heimdall/README.md, Wazuh MCP).
WAZUH_MCP_URL=

# telegram add-on: the bot tg-admin talks to (@name). The bot token lives in its own 0600 file, not here.
TG_ADMIN_BOT=
