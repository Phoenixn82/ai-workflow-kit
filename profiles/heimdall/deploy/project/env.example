# ~/apps/<name>/.env (mode 600). Read by docker compose for the values below, and handed to the app.
APP_NAME=myapp
APP_IMAGE=ghcr.io/you/myapp:1.0.0
# the loopback port on heimdall (one per project) and the port the app listens on inside its container
APP_PORT=8081
APP_INTERNAL_PORT=8080
# path that answers 200 when the app is healthy (deploy.sh and restore.sh wait for it; add it to Uptime Kuma)
APP_HEALTH_PATH=/
# the app's own settings and secrets below, e.g.
#DATABASE_URL=sqlite:////data/app.db
