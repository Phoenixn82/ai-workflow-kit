# ~/.config/restic/heimdall.env (mode 600): where backup.sh and restore.sh keep project backups (restic).
# Pick ONE repository. The password lives in its own file (mode 600): lose it and the backups cannot be read,
# so keep a copy in your password manager.
#   mkdir -p ~/.config/restic && cp profiles/heimdall/deploy/restic.env.example ~/.config/restic/heimdall.env
#   chmod 600 ~/.config/restic/heimdall.env && (umask 077; openssl rand -base64 32 > ~/.config/restic/heimdall.pass)
# backup.sh creates the repository on its first run.
export RESTIC_REPOSITORY=/srv/restic/heimdall           # a second disk or a USB disk on heimdall: simplest
#export RESTIC_REPOSITORY=sftp:thor-restic:/srv/backups/restic-heimdall   # thor, through an ssh alias on port 2222
#export RESTIC_REPOSITORY=rest:http://thor:8000/heimdall                 # a restic rest-server
#export RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/heimdall      # an S3-compatible bucket; keys in AWS_* vars
export RESTIC_PASSWORD_FILE=$HOME/.config/restic/heimdall.pass
# A repository on thor: thor sleeps when idle. With these three, backup.sh wakes it and waits for the port first.
#WAKE_HOST=thor
#WAKE_MAC=XX:XX:XX:XX:XX:XX
#WAKE_PORT=22
