#!/bin/sh
# /lib/systemd/system-sleep/fleet-hold: before ANY suspend (manual or thor-sleep), tell heimdall's fleet-wake
# it is on purpose, or it sends a Wake-on-LAN packet after two missed checks and re-wakes thor.
[ "$1" = pre ] || exit 0
runuser -u you -- ssh -o BatchMode=yes -o ConnectTimeout=5 heimdall true >/dev/null 2>&1 \
  || logger -t fleet-hold "fleet-wake hold failed; heimdall may wake thor early"
exit 0
