def self_test():
    p = parser()
    a = p.parse_args(["groups", "ensure", "Lane Intel", "--add", "@x_bot", "--post", "hi", "--dry-run"])
    assert (a.title, a.add, a.post, a.dry_run, a.admin) == ("Lane Intel", "@x_bot", "hi", True, False)
    assert p.parse_args(["groups", "ensure-topics"]).bot == DEFAULT_BOT
    global KIT_HOSTS  # TG_ADMIN_BOT: environment, else hosts.env, else "" (ensure-topics then asks for --bot)
    real, saved = KIT_HOSTS, os.environ.pop("TG_ADMIN_BOT", None)
    with tempfile.TemporaryDirectory() as d:
        KIT_HOSTS = Path(d) / "hosts.conf"
        try:
            assert hosts_env("TG_ADMIN_BOT") == ""
            KIT_HOSTS.write_text("# c\nTG_ADMIN_BOT=@a_bot\n")
            assert hosts_env("TG_ADMIN_BOT") == "@a_bot"
            os.environ["TG_ADMIN_BOT"] = "b_bot"
            assert hosts_env("TG_ADMIN_BOT") == "b_bot"
        finally:
            KIT_HOSTS = real
            os.environ.pop("TG_ADMIN_BOT", None)
            if saved is not None:
                os.environ["TG_ADMIN_BOT"] = saved
    assert p.parse_args(["bots", "create", "My Bot", "@my_test_bot"]).username == "my_test_bot"
    assert p.parse_args(["bots", "token-rotate", "a_bot", "--dry-run"]).dry_run
    assert p.parse_args(["bots", "token-rotate", "a_bot", "--force"]).force
    for bad in (["bots", "create", "X", "nosuffix"], ["bots", "create", "X", "ab_bot!"], ["groups"]):
        with contextlib.redirect_stderr(io.StringIO()), contextlib.suppress(SystemExit):
            p.parse_args(bad)
            raise AssertionError(f"accepted {bad}")
    with tempfile.TemporaryDirectory() as d:
        d = Path(d)
        assert topic_titles(d / "missing.json") == DEFAULT_TOPICS
        (d / "bad.json").write_text("{nope")
        assert topic_titles(d / "bad.json") == DEFAULT_TOPICS
        (d / "t.json").write_text(json.dumps({"topics": {"heat": {"chat_id": None, "notify": True},
                                                         "lane-intel": {"chat_id": -1}, "x": {"title": "X Feed"}},
                                              "default_chat_id": "1"}))
        assert topic_titles(d / "t.json") == ["Heat", "Lane Intel", "X Feed"]
        (d / "l.json").write_text("[1, 2]")
        assert topic_titles(d / "l.json") == DEFAULT_TOPICS
        old = os.umask(0)
        try:
            f = d / "bots" / "x_bot.token"
            f.parent.mkdir()
            f.write_text("old")
            f.chmod(0o644)
            write_secret(f, "tok")
            write_secret(d / "new" / "y_bot.token", "tok")
            assert f.stat().st_mode & 0o777 == 0o600 and f.read_text() == "tok\n"
            assert (d / "new" / "y_bot.token").stat().st_mode & 0o777 == 0o600
            assert (d / "new").stat().st_mode & 0o777 == 0o700
        finally:
            os.umask(old)
    gs = [types.SimpleNamespace(title=t) for t in ("Jobs 2", "lane intel", "Weekly-Review", "Mail Old")]
    assert find_group("Lane Intel", gs) is gs[1] and find_group("Weekly Review", gs) is gs[2]
    assert find_group("Jobs", gs) is None and find_group("Mail", gs) is None
    for text, want in SAMPLES:
        assert parse_token(text) == want
    assert first_line("token " + SAMPLES[0][1] + "\nmore") == "token <token>"
    auth_test()
    print("self-test: ok")


def auth_test():
    """audit S11: cloud 2FA never silently turns the import into a shared Telegram Desktop session; each mode prints
    its own revocation steps. opentele, PyQt5 and telethon are faked, so this runs without the venv. The fakes keep
    the real connection states: opentele's UseCurrentSession client comes back unconnected (a query on it raises)."""
    from unittest import mock
    global CFG, SESSION, MODE
    NoPw, BadPw = type("NoPasswordProvided", (Exception,), {}), type("PasswordIncorrect", (Exception,), {})
    new_flag, cur_flag, calls = object(), object(), []

    class Client:  # telethon's TelegramClient; Settings > Devices shows the device of the last connect (initConnection)
        def __init__(self, session=None, api_id=None, api_hash=None, connected=False, **kw):
            self.connected, self.model = connected, kw.get("device_model", "Desktop PC")

        async def connect(self):
            self.connected = True

        async def is_user_authorized(self):
            return True

        async def __call__(self, req):
            if not self.connected:
                raise ConnectionError("Cannot send requests while disconnected")
            return types.SimpleNamespace(authorizations=[types.SimpleNamespace(
                current=True, device_model=self.model, app_name="Telegram Desktop", app_version="7.2.5", platform="Linux")])

        async def disconnect(self):
            self.connected = False

    class TDesktop:
        def __init__(self, path, passcode=None):
            pass

        async def ToTelethon(self, session, flag, api=None, password=None):
            calls.append(("shared" if flag is cur_flag else "new", password))
            Path(session).touch()  # both flags open the SQLite session file first
            if flag is new_flag and password != "pw":
                raise NoPw() if password is None else BadPw()
            return Client(connected=flag is new_flag)  # CreateNewSession: QR login left it connected

    mod = lambda **kw: types.SimpleNamespace(**kw)
    fakes = {"PyQt5.QtCore": mod(QByteArray=lambda: None),
             "opentele.api": mod(API=mod(TelegramDesktop=lambda **kw: kw), CreateNewSession=new_flag,
                                 UseCurrentSession=cur_flag),
             "opentele.exception": mod(NoPasswordProvided=NoPw, PasswordIncorrect=BadPw, OpenTeleException=Exception,
                                       TDataBadDecryptKey=type("TDataBadDecryptKey", (Exception,), {})),
             "opentele.td": mod(TDesktop=TDesktop), "opentele.td.account": mod(StorageAccount=type("SA", (), {})),
             "telethon": mod(TelegramClient=Client),
             "telethon.tl.functions.account": mod(GetAuthorizationsRequest=lambda: None)}

    async def first_run(share):  # what `tg-admin [--share-desktop-session] whoami` does with the session
        (await client(share)).connected = False

    def attempt(share, tty, password=None):
        del calls[:]
        err = io.StringIO()
        with mock.patch.dict(sys.modules, fakes), mock.patch.object(sys, "stdin", mod(isatty=lambda: tty)), \
                mock.patch("getpass.getpass", lambda prompt="": password), contextlib.redirect_stderr(err):
            try:
                asyncio.run(first_run(share))
            except SystemExit as e:
                return f"exit: {e}"
        return err.getvalue()

    real, umask = (CFG, SESSION, MODE), os.umask(0o077)
    entry = 'lists it as "Telegram Desktop 7.2.5 on tg-admin, Linux"'
    with tempfile.TemporaryDirectory() as d:
        CFG = Path(d) / "telegram"
        SESSION, MODE = CFG / "user.session", CFG / "tg-admin.mode"
        try:
            out = attempt(False, tty=False)  # 2FA, no terminal: stop and explain, never share, keep nothing
            assert out.startswith("exit: Cloud 2FA") and "--share-desktop-session" in out and calls == [("new", None)], out
            assert session_mode() is None and not SESSION.exists()
            out = attempt(False, tty=True, password="pw")  # 2FA in a terminal: still a separate device
            assert calls == [("new", None), ("new", "pw")] and "new device 'tg-admin'" in out, (calls, out)
            assert 'own device, "tg-admin"' in out and entry in out and "Terminate" in out and "SHARES" not in out, out
            assert session_mode() == "own-device" and oct(SESSION.stat().st_mode & 0o777) == "0o600"
            out = attempt(True, tty=False)  # the flag never re-imports an existing session
            assert calls == [] and "--share-desktop-session ignored" in out and session_mode() == "own-device", out
            forget_session()
            out = attempt(False, True, "wrong")  # wrong cloud password
            assert out.startswith("exit: wrong cloud password") and ("shared", None) not in calls, (calls, out)
            assert not SESSION.exists() and session_mode() is None
            out = attempt(True, tty=False)  # explicit opt-in: shared, and it names the Devices entry to terminate
            assert calls == [("shared", None)] and "SHARES Telegram Desktop" in out and entry in out, (calls, out)
            assert "does not revoke a copy" in out and "logs Telegram Desktop out" in out and session_mode() == "shared"
            assert "strict way" in revoke_steps(None) and "does not revoke a copy" in revoke_steps(None)
            forget_session()
            assert not MODE.exists() and session_mode() is None
        finally:
            (CFG, SESSION, MODE), _ = real, os.umask(umask)
    assert parser().parse_args(["--share-desktop-session", "whoami"]).share_desktop_session
    assert not parser().parse_args(["session"]).share_desktop_session


def main():
    a = parser().parse_args()
    if a.self_test:
        return self_test()
    if not a.cmd:
        return parser().print_help()
    asyncio.run(run(a))


if __name__ == "__main__":
    main()
