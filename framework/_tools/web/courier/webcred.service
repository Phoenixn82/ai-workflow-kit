[Unit]
Description=webcred one-way credential courier (spec 3.5)
Requires=webcred.socket
After=webcred.socket

[Service]
Type=simple
User=webcred
Group=webcred
ExecStart=/usr/bin/python3 -I /usr/local/lib/webcred/webcred.py
# sync-google's import dir (made by webcred.socket): every stop (idle exit, crash, SIGKILL) shreds whatever an
# import left in it. As webcred, sandboxed (no '+'): webcred owns everything it can create there.
ExecStopPost=-/usr/bin/find /run/webcred/import -xdev -type f -exec /usr/bin/shred -u -- {} +
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ProtectHome=yes
ProtectSystem=strict
# '-': without the import dir the courier still serves; only sync-google refuses (import-dir).
ReadWritePaths=/var/lib/webcred -/run/webcred/import
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
# Decrypted records live in this process (and in age, its child): never in a core file or in swap.
LimitCORE=0
MemorySwapMax=0
SystemCallFilter=@system-service
ProcSubset=pid
PrivateIPC=yes
