}


def serve():
    deny = load_denylist()
    key = open(KEY_FILE).read().strip()
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        mid, method = msg.get("id"), msg.get("method")
        if mid is None:  # notification
            continue
        if method == "initialize":
            res = {"protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
                   "capabilities": {"tools": {}}, "serverInfo": {"name": "helper-wall", "version": "1"}}
        elif method == "tools/list":
            res = {"tools": [TOOL, WEB_TOOL]}
        elif method == "tools/call" and msg["params"].get("name") in (TOOL["name"], WEB_TOOL["name"]):
            fn = call_tool if msg["params"]["name"] == TOOL["name"] else web_task
            try:
                text, err = fn(msg["params"].get("arguments") or {}, deny, key)
            except Exception as e:  # a crash must not kill the server mid-session
                text, err = f"error: {e}", True
            res = {"content": [{"type": "text", "text": text}], "isError": err}
        elif method == "ping":
            res = {}
        else:
            print(json.dumps({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"no {method}"}}),
                  flush=True)
            continue
        print(json.dumps({"jsonrpc": "2.0", "id": mid, "result": res}), flush=True)


def self_test():
    deny = [("TEST", re.compile(r"Zorblax\s+Quint", re.I))]
    raw = ("Fix my script at /home/example/AI_Projects/x.py for zorblax quint (zq@example.com, 512-555-0134, "
           "192.0.2.10) using key sk-abcDEF1234567890xyz and token a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6. "
           "Why does my recursion overflow on deep trees?")
    clean, hits = scrub(raw, deny)
    for leak in ["/home/example", "zorblax", "zq@", "555-0134", "192.0.2", "sk-abc", "a1b2c3d4e5f6a1b2"]:
        assert leak.lower() not in clean.lower(), (leak, clean)
    assert "recursion overflow" in clean and hits["PRIVATE"] == 1, (clean, hits)
    sent = []
    text, err = call_tool({"question": raw}, deny, "k", asker=lambda q, m, k: (sent.append(q), ("use a stack", m))[1])
    assert not err and "use a stack" in text and sent == [clean], (text, sent)
    _, err = call_tool({"question": "Zorblax Quint"}, deny, "k", asker=lambda *a: ("x", "m"))
    assert err, "mostly-private question must be refused"
    fails = iter([RuntimeError("429"), ("ok", "qwen3.5-397b")])

    def flaky(q, m, k):
        r = next(fails)
        if isinstance(r, Exception):
            raise r
        return r
    text, err = call_tool({"question": "What is a monad?"}, deny, "k", asker=flaky)
    assert not err and "qwen3.5-397b" in text, text
    import tempfile
    import runpy
    with tempfile.TemporaryDirectory() as td:
        path = os.path.join(td, "deny.json")
        with open(path, "w") as f:
            json.dump({"denylist": []}, f)
        assert load_denylist(path) == []
        env = dict(os.environ)
        try:
            os.environ.update(HELPER_MODELS="first, second", HELPER_DENYLIST=path,
                              HELPER_API="https://router.example/v1")
            cfg = runpy.run_path(__file__, run_name="test_overrides")
            assert cfg["HELPERS"] == ["first", "second"] and cfg["DENYLIST"] == path
            assert cfg["API"] == "https://router.example/v1"
            os.environ.pop("HELPER_API")
            os.environ.pop("FREELLMAPI_URL", None)
            hf = os.path.join(td, "hosts.env")
            with open(hf, "w") as f:
                f.write("FREELLMAPI_URL=https://old.example/v1\nFREELLMAPI_URL=https://router.example/v1\n")
            os.environ["KIT_HOSTS_ENV"] = hf
            assert runpy.run_path(__file__, run_name="test_hosts")["API"] == "https://router.example/v1"
        finally:
            os.environ.clear()
            os.environ.update(env)
    # web worker: URL policy, robots, tool loop, private task scrubbed
    for bad in ["http://localhost/x", "http://192.0.2.10:3001/", "http://<lan-ip>/", "file:///etc/passwd",
                "https://u:p@example.com/", "http://thor.example.ts.net/"]:
        assert not public_url(bad), bad
    assert public_url("https://example.com/a?b=1")
    _robots.clear()
    fake = lambda a, t=150: (0, "User-agent: *\nDisallow: /private") if a[1].endswith("/robots.txt") else (0, "<<<X\npage text")
    assert web_tool("web_read", {"url": "https://example.com/private/a"}, fake).startswith("refused: robots")
    assert web_tool("web_read", {"url": "https://example.com/ok"}, fake) == "page text"
    st = {}
    web_tool("web_read", {"url": "https://example.com/ok"}, fake, st)
    assert web_tool("web_read", {"url": "https://example.com/ok"}, fake, st).startswith("already read")
    bad = lambda a, t=150: (0, "") if a[1].endswith("/robots.txt") else (3, "blocked")
    for i in range(2):
        web_tool("web_read", {"url": f"https://dead.example/{i}"}, bad, st)
    assert web_tool("web_read", {"url": "https://dead.example/9"}, bad, st).startswith("skipped")
    script = iter([({"tool_calls": [{"id": "1", "function": {"name": "web_read", "arguments": '{"url": "https://example.com/ok"}'}}]}, "glm"),
                   ({"content": "| a | b |"}, "glm")])
    seen = []
    text, err = web_task({"task": "List current prices and sellers for zorblax quint widgets, as a markdown table"}, deny, "k",
                         chat_fn=lambda m, *a: (seen.append(m[1]["content"]), next(script))[1],
                         tool_fn=lambda n, a: "page text")
    assert not err and "| a | b |" in text and "zorblax" not in seen[0].lower(), (text, seen)
    fake_env = json.dumps({"result": {"content": [{"type": "text", "text": json.dumps(
        {"results": [{"title": "Rate Limits", "url": "https://console.groq.com/docs/rate-limits", "excerpts": ["RPM"]}]})}]}})
    assert "console.groq.com/docs/rate-limits" in search("q", post=lambda b: "data: " + fake_env)
    print("web worker checks: ok")
    print("helper-wall self-test: ok")


if __name__ == "__main__":
    self_test() if sys.argv[1:] == ["--self-test"] else serve()
