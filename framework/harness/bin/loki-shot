#!/usr/bin/env bash
# Screenshot of Loki's desktop (the loki-desk VM that "Loki Screen" shows), saved on odin.
# Pixel coordinates match `loki-gui` (xdotool on the VM's :0). Prints the saved path.
set -euo pipefail
out=${1:-/tmp/loki-shot-$(date +%Y%m%d-%H%M%S).png}
ssh loki-desk 'DISPLAY=:0 xwd -root -silent' | magick xwd:- "$out"
echo "$out"
