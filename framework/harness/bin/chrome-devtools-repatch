#!/usr/bin/env python3
"""Re-add --executablePath=/usr/bin/chromium to the chrome-devtools-mcp plugin after an update.

odin has no Google Chrome, only Chromium, and every plugin update ships a fresh cache dir
without the flag. Idempotent: patches each cached version's .claude-plugin/plugin.json and
mcp.json / .mcp.json where the chrome-devtools server's args lack the flag, prints what it
changed, and does nothing otherwise. Run `/mcp` (reconnect) afterwards if anything changed.
See harness memory `chrome-devtools-chromium-path`.
"""
import json
import shutil
import sys
from pathlib import Path

FLAG = "--executablePath=/usr/bin/chromium"
ROOT = Path.home() / ".claude/plugins/cache/claude-plugins-official/chrome-devtools-mcp"
NAMES = (".claude-plugin/plugin.json", "mcp.json", ".mcp.json")


def patch(path: Path) -> str:
    data = json.loads(path.read_text())
    servers = data.get("mcpServers") or {}
    changed = []
    for name, srv in servers.items():
        args = srv.get("args")
        if not isinstance(args, list) or not any("chrome-devtools-mcp" in str(a) for a in args):
            continue
        if any(str(a).startswith("--executablePath") for a in args):
            continue
        args.append(FLAG)
        changed.append(name)
    if not changed:
        return ""
    backup = path.with_name(path.name + ".bak")
    if not backup.exists():
        shutil.copy2(path, backup)
    path.write_text(json.dumps(data, indent=2) + "\n")
    return f"patched {path} (server: {', '.join(changed)})"


def main() -> int:
    if not ROOT.is_dir():
        print(f"chrome-devtools-repatch: no plugin cache at {ROOT}", file=sys.stderr)
        return 1
    seen = 0
    for version in sorted(p for p in ROOT.iterdir() if p.is_dir()):
        for rel in NAMES:
            f = version / rel
            if not f.is_file():
                continue
            seen += 1
            try:
                msg = patch(f)
            except (OSError, ValueError) as e:
                print(f"chrome-devtools-repatch: skipped {f}: {e}", file=sys.stderr)
                continue
            print(msg or f"ok {f} (flag already present or no chrome-devtools server)")
    if not seen:
        print(f"chrome-devtools-repatch: no plugin.json / mcp.json under {ROOT}/*/", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
